{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FinSense: Streamlit app",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app.py"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "FinSense: Unit tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "tests", "-v"],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}